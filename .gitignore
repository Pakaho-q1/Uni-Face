# ==========================================
# Byte-compiled / optimized / DLL files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.dll
*.dylib

# ==========================================
# Distribution / packaging
# ==========================================
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==========================================
# Virtual Environments & Configs
# ==========================================
.env
.env.local
.env.*.local
.venv
venv/
ENV/
env/
env.bak/
venv.bak/

# ==========================================
# Uni-Face Workspaces & User Data
# ==========================================
workspace/
!workspace/.gitkeep

# Models directory: ignore large weights and binaries, keep hash integrity files
models/**/*.onnx
models/*.onnx
models/**/*.dfm
models/*.dfm
models/**/*.bin
models/**/*.pt
models/**/*.pth
models/**/*.safetensors
models/*.exe
models/**/*.exe
models/ffmpeg.exe
!models/*.hash
!models/**/*.hash
!models/.gitkeep

# Temporary test directories and staging
immich_staging_*
immich_target_test/
test_dir/
image/
*.png
!webui/public/*.png
!webui/src/assets/*.png

# Database & SQLite files
*.sqlite
*.sqlite3
*.db
!tests/fixtures/*.db

# Log files
*.log
logs/

# ==========================================
# Frontend (WebUI / Node.js)
# ==========================================
webui/node_modules/
# Allow pre-built webui/dist to be committed for standalone runtime without node
!webui/dist/
webui/dist-ssr/
webui/.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# IDE / Operating System Files
# ==========================================
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

